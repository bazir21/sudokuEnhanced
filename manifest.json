{
  "manifest_version": 3,
  "name": "BetterSudoku",
  "version": "1.1.1",
  "minimum_chrome_version": "148",
  "description": "Keyboard shortcuts, dark mode, and a cleaner UI for Sudoku.com",
  "permissions": ["storage"],
  "icons": {
    "48": "assets/icon-48.png",
    "96": "assets/icon-96.png"
  },
  "action": {
    "default_popup": "components/popup.html",
    "default_icon": {
      "48": "assets/icon-48.png",
      "96": "assets/icon-96.png"
    }
  },
  "options_ui": {
    "page": "components/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.sudoku.com/*",
        "https://sudoku.com/*"
      ],
      "css": [
        "darkMode.css",
        "components/darkModeVars.css"
      ],
      "js": [
        "constants.js",
        "shortcutHelpers.js",
        "sudokuEnhanced.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-sudoku@bazir.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
